{
  "name": "@footprintjs/assessment",
  "version": "0.3.0",
  "description": "A local software assessment workbench with traceable evidence and human review.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "assessment": "bin/assessment.mjs"
  },
  "scripts": {
    "start": "node bin/assessment.mjs studio",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "check": "npm run typecheck && node scripts/build-viewer.mjs --check && npm test",
    "build:viewer": "node scripts/build-viewer.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@xyflow/react": "12.10.2",
    "footprint-explainable-ui": "0.38.0",
    "footprintjs": "9.44.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tar": "7.5.22"
  },
  "files": [
    "bin",
    "src",
    "web",
    "README.md",
    "LICENSE"
  ]
}
